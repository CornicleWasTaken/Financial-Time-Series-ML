# Copy to `.env` and adjust as needed. NEVER commit a real `.env`.

# --- Runtime ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Data ---
# DATA_DIR=/abs/path/to/data

# --- Tracking ---
# MLflow tracking URI. Defaults to a local `mlruns/` directory.
# MLFLOW_TRACKING_URI=file:./mlruns

# --- Persistence (later phases) ---
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/financial_ml

# --- API (later phases) ---
# API_HOST=0.0.0.0
# API_PORT=8000
